{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://athletics-beverages-aspect-hospital.trycloudflare.com/api/:path*" },
    { "source": "/agents/:path*", "destination": "https://athletics-beverages-aspect-hospital.trycloudflare.com/agents/:path*" },
    { "source": "/.well-known/:path*", "destination": "https://athletics-beverages-aspect-hospital.trycloudflare.com/.well-known/:path*" }
  ]
}
