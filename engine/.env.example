# Team name — used as HSP merchant_name for prize attribution. Must match everywhere.
HSP_MERCHANT_NAME=Concord

# sim = local HSP simulator (real EIP-712 signing, no chain) · live = HSP Agentic Payment MCP (QA)
HSP_MODE=sim
HSP_MCP_URL=https://mcp-qa.hashkeymerchant.com/
HSP_NETWORK=hashkey-testnet
HSP_COIN=USDC
# deal value (USD) × scale = amount settled through HSP; keeps testnet spend tiny
HSP_AMOUNT_SCALE=0.001
# live mode: require a dashboard click before signing and before submitting (per HSP guide)
HSP_REQUIRE_CONFIRM=true
# funded payer wallet for live mode (holds test USDC on HashKey testnet). Never commit.
PAYER_PRIVATE_KEY=

# Claude negotiation (optional — falls back to rule-based heuristics)
ANTHROPIC_API_KEY=
CONCORD_MODEL=claude-sonnet-5-5

# ConcordLedger on HSK Chain (optional — without it, ledger entries stay local)
HSK_RPC_URL=https://mainnet.hsk.xyz
HSK_CHAIN_ID=177
HSK_EXPLORER=https://hashkey.blockscout.com
CONCORD_LEDGER_ADDRESS=
OPERATOR_PRIVATE_KEY=
# max settlements anchored on-chain per engine run (~0.13 HSK each at 500 gwei)
LEDGER_MAX_SETTLEMENTS=20

TICK_MS=2500
FAIR_BAND=0.15
DISTRESS_BAND=0.03
